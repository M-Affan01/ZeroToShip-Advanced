          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"WrongPassword123!\"\n}"
        }
      }
    },
    {
      "name": "Login - Non-existent User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Error message is generic', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('detail');",
              "    pm.expect(jsonData.detail).to.include('Invalid email or password');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nonexistent@campus.edu\",\n  \"password\": \"AnyPassword123!\"\n}"
        }
      }
    },
    {
      "name": "JWT Token Structure Validation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Access token has 3 parts separated by dots', function () {",
              "    var jsonData = pm.response.json();",
              "    var token = jsonData.access_token;",
              "    var parts = token.split('.');",
              "    pm.expect(parts.length).to.equal(3);",
              "});",
              "",
              "pm.test('Refresh token has 3 parts separated by dots', function () {",
              "    var jsonData = pm.response.json();",
              "    var token = jsonData.refresh_token;",
              "    var parts = token.split('.');",
              "    pm.expect(parts.length).to.equal(3);",
              "});",
              "",
              "pm.test('Token type is JWT', function () {",
              "    var jsonData = pm.response.json();",
              "    var header = JSON.parse(atob(jsonData.access_token.split('.')[0]));",
              "    pm.expect(header).to.have.property('alg');",
              "    pm.expect(header.alg).to.equal('HS256');",
              "    pm.expect(header).to.have.property('typ');",
              "    pm.expect(header.typ).to.equal('JWT');",
              "});",
              "",
              "pm.test('Access token contains required claims', function () {",
              "    var jsonData = pm.response.json();",
              "    var payload = JSON.parse(atob(jsonData.access_token.split('.')[1]));",
              "    pm.expect(payload).to.have.property('sub');",
              "    pm.expect(payload).to.have.property('email');",
              "    pm.expect(payload).to.have.property('roles');",
              "    pm.expect(payload).to.have.property('iat');",
              "    pm.expect(payload).to.have.property('exp');",
              "    pm.expect(payload).to.have.property('jti');",
              "    pm.expect(payload).to.have.property('iss');",
              "    pm.expect(payload).to.have.property('aud');",
              "    pm.expect(payload).to.have.property('type');",
              "    pm.expect(payload.iss).to.equal('auth-api');",
              "    pm.expect(payload.aud).to.equal('microservices');",
              "    pm.expect(payload.type).to.equal('access');",
              "    pm.expect(payload.email).to.equal(pm.environment.get('test_email'));",
              "    pm.expect(payload.roles).to.be.an('array');",
              "    pm.expect(payload.roles).to.include('user');",
              "});",
              "",
              "pm.test('Refresh token contains required claims', function () {",
              "    var jsonData = pm.response.json();",
              "    var payload = JSON.parse(atob(jsonData.refresh_token.split('.')[1]));",
              "    pm.expect(payload).to.have.property('sub');",
              "    pm.expect(payload).to.have.property('email');",
              "    pm.expect(payload).to.have.property('roles');",
              "    pm.expect(payload).to.have.property('jti');",
              "    pm.expect(payload).to.have.property('type');",
              "    pm.expect(payload).to.have.property('iss');",
              "    pm.expect(payload).to.have.property('aud');",
              "    pm.expect(payload.iss).to.equal('auth-api');",
              "    pm.expect(payload.aud).to.equal('microservices');",
              "    pm.expect(payload.type).to.equal('refresh');",
              "    pm.expect(payload.email).to.equal(pm.environment.get('test_email'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
        }
      }
    },
    {
      "name": "Login - Account Lockout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Account gets locked after max attempts', function () {",
              "    var jsonData = pm.response.json();",
              "    if (pm.response.code === 403) {",
              "        pm.expect(jsonData.detail).to.include('locked');",
              "        pm.expect(pm.response.code).to.equal(403);",
              "    } else {",
              "        pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"lockout.test@campus.edu\",\n  \"password\": \"WrongPassword1!\"\n}"
        }
      }
    },
    {
      "name": "Health Check - Redis Connected",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
